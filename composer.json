{
    "name": "mineadmin/components",
    "description": "MineAdmin Laravel components",
    "license": "Apache-2.0",
    "keywords": [
        "MineAdmin",
        "Laravel",
        "admin",
        "plugin"
    ],
    "authors": [
        {
            "name": "xmo",
            "email": "root@imoi.cn",
            "role": "Developer"
        },
        {
            "name": "zds",
            "role": "Developer"
        }
    ],
    "homepage": "http://www.mineadmin.com",
    "require": {
        "php": "^8.4",
        "composer/semver": "^3.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Mine\\AppStore\\": "src/AppStore/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mine\\AppStore\\AppStoreServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "pest tests/AppStore",
        "test-coverage": "pest tests/AppStore --coverage --min=90"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
